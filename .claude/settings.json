{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash"
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "model": "claude-opus-4-7",
  "alwaysThinkingEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [[ \"$f\" == *.py ]]; then python3 -m py_compile \"$f\" 2>/dev/null || true; fi; } 2>/dev/null || true",
            "statusMessage": "Validating Python syntax",
            "if": "Write|Edit(*.py)"
          }
        ]
      }
    ]
  }
}
